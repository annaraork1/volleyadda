# VolleyAdda — platform deployment (do not copy secrets from TNHVPL)

# Auth / platform
SUPERADMIN_EMAILS=you@example.com
# Comma-separated verified emails that get superadmin
APP_URL=https://volleyadda.vercel.app
RESEND_API_KEY=
# From address for verify / reset mail, e.g. VolleyAdda <onboarding@resend.dev>
EMAIL_FROM=VolleyAdda <onboarding@resend.dev>

# Google / Apple sign-in (optional until store builds)
# Web OAuth client ID from Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=
# Same value as GOOGLE_CLIENT_ID — required so the browser can show the Google button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required for mobile Google sign-in (OAuth code exchange on the server)
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=

# Session cookie signing (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Upstash Redis (can share the TNH instance — keys are namespaced)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Isolates VolleyAdda keys from TNH on a shared Upstash (default in code is vada: if unset)
REDIS_KEY_PREFIX=vada:

# Vercel Blob (Storage → Blob) — required for the photo gallery; use VolleyAdda's own store
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_ACCESS=private

# Optional default tournament key for empty installs
TOURNAMENT_KEY=demo
